# Copy to .env for local development (never commit the real .env file — it's
# already in .gitignore). In production these are set as Vercel Environment
# Variables, not committed to source control.

# --- Database (Supabase, accessed via PostgREST) ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --- Auth (admin dashboard) ---
# Required in production — the app refuses admin login/token signing if unset
# in production rather than falling back to an insecure default.
ADMIN_PASSWORD=
JWT_SECRET=

# --- Razorpay (online payments) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Email notifications (optional — order confirmations are skipped silently if unset) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ADMIN_EMAIL=
